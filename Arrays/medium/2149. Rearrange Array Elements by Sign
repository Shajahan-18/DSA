class Solution {
    public int[] rearrangeArray(int[] nums) {
        int n=nums.length;
        int []result=new int [n];

        int p=0;
        int N=1;

        for(int num:nums)
        if(num>0){
           result[p]=num;
           p+=2;

        }else{
            result[N]=num;
            N+=2;
        }


        return result;
        



        
    }
}
